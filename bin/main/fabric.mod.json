{
  "schemaVersion": 1,
  "id": "sheetas-armor-hud",
  "version": "${version}",
  "name": "sheeta's Armor HUD",
  "description": "This mod adds a minimalistic vanilla-like widget that shows your armor items and a warning if durability is low enough. Forked by sheeta.",
  "authors": ["BerdinskiyBear", "uku", "sheeta"],
  "contributors": [],
  "contact": {
    "homepage": "https://github.com/sheetau/armor-hud",
    "issues": "https://github.com/sheetau/armor-hud/issues",
    "discord": "https://discord.gg/2dXs5HwXuW"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/2dXs5HwXuW",
        "ko-fi": "https://ko-fi.com/sheeta"
      }
    }
  },
  "license": "MIT",
  "icon": "assets/sheetas-armor-hud/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["ru.berdinskiybear.armorhud.ArmorHudMod"],
    "ukulib": ["ru.berdinskiybear.armorhud.config.UkulibIntegration"]
  },
  "mixins": ["sheetas-armor-hud.mixins.json"],
  "accessWidener": "sheetas-armor-hud.accesswidener",
  "depends": {
    "fabricloader": ">=0.15",
    "minecraft": ">=1.21",
    "ukulib": "^1.4.0"
  },
  "breaks": {
    "armor_hud": "*"
  }
}
